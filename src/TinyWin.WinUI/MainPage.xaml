<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TinyWin.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TinyWin.WinUI.Models"
    Loaded="Page_Loaded">
    <Grid Padding="28" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="TinyWin" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="按条目选择 Windows 离线镜像精简操作" Opacity="0.72" />
        </StackPanel>
        <TextBox Grid.Row="1" Header="Windows ISO 或已挂载介质目录" Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Header="镜像索引" Text="{x:Bind ViewModel.ImageIndexText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Grid.Column="1" Margin="0,28,0,0" Content="生成可启动 ISO（需要 ADK oscdimg.exe）" IsChecked="{x:Bind ViewModel.CreateIso, Mode=TwoWay}" />
        </Grid>
        <TextBlock Grid.Row="3" Text="精简条目（勾选后执行）" FontWeight="SemiBold" />
        <ListView Grid.Row="4" ItemsSource="{x:Bind ViewModel.Entries}" SelectionMode="None" MaxHeight="300">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:TinyWinEntry">
                    <Grid Padding="4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" />
                            <TextBlock Text="{x:Bind Description}" Opacity="0.68" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Category}" HorizontalAlignment="Right" Opacity="0.68" />
                            <TextBlock Text="{x:Bind Risk}" HorizontalAlignment="Right" Opacity="0.68" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12">
            <Button Content="重新加载条目" Command="{x:Bind ViewModel.RefreshEntriesCommand}" />
            <Button Content="开始构建" Command="{x:Bind ViewModel.BuildCommand}" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
        <Grid Grid.Row="6" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontWeight="SemiBold" />
            <TextBox Grid.Row="1" Text="{x:Bind ViewModel.BuildLog, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono" />
        </Grid>
    </Grid>
</Page>
