{
  "schemaVersion": 1,
  "id": "registry.disable-uac",
  "version": "1.0.0",
  "title": "禁用用户帐户控制 (UAC)",
  "description": "将 EnableLUA 设为 0。需要重启；Microsoft Store 应用和依赖 UAC 的功能可能无法运行。",
  "category": "Security",
  "risk": "High",
  "handler": "Registry.SetOfflineValue",
  "phase": "MountedImage",
  "parameters": {
    "hive": "SOFTWARE",
    "key": "Microsoft\\Windows\\CurrentVersion\\Policies\\System",
    "name": "EnableLUA",
    "type": "DWord",
    "value": 0
  }
}
