{
  "schemaVersion": 1,
  "id": "registry.disable-edge-update",
  "version": "1.0.0",
  "title": "禁用 Microsoft Edge 更新服务",
  "description": "禁用 edgeupdate 和 edgeupdatem；Edge 不会自动更新，依赖 Edge WebView/Edge 的组件可能停留在旧版本。",
  "category": "Browser",
  "risk": "Medium",
  "selectionTier": "Standard",
  "handler": "Registry.DisableOfflineService",
  "phase": "MountedImage",
  "parameters": {
    "services": ["edgeupdate", "edgeupdatem"]
  }
}
