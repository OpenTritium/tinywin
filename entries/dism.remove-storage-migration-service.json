{
  "schemaVersion": 1,
  "id": "dism.remove-storage-migration-service",
  "version": "1.0.0",
  "title": "移除存储迁移服务",
  "description": "移除 Storage Migration Service、管理组件和代理；无法使用 Windows Server 存储迁移工具。",
  "category": "Server Roles",
  "risk": "High",
  "handler": "Dism.RemoveOptionalComponent",
  "phase": "MountedImage",
  "parameters": {
    "features": ["StorageMigrationService", "StorageMigrationServiceManagement", "StorageMigrationServiceProxy"],
    "removePayload": true
  }
}
