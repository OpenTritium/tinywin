{
  "schemaVersion": 1,
  "id": "dism.remove-powershell-v2",
  "version": "1.0.0",
  "title": "移除 Windows PowerShell 2.0",
  "description": "移除已弃用的 PowerShell 2.0 兼容组件；Windows PowerShell 5.1、PowerShell 7 和 Server Manager 不受影响。",
  "category": "Developer",
  "risk": "Medium",
  "handler": "Dism.RemoveOptionalComponent",
  "phase": "MountedImage",
  "parameters": {
    "features": ["MicrosoftWindowsPowerShellV2", "MicrosoftWindowsPowerShellV2Root"],
    "removePayload": true
  }
}
