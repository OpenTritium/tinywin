{
  "schemaVersion": 1,
  "id": "dism.remove-message-queue",
  "version": "1.0.0",
  "title": "移除 Microsoft Message Queuing",
  "description": "移除 MSMQ、HTTP、路由、触发器和目录服务集成；依赖消息队列的应用将无法运行。",
  "category": "Server Roles",
  "risk": "High",
  "handler": "Dism.RemoveOptionalComponent",
  "phase": "MountedImage",
  "parameters": {
    "features": ["MSMQ", "MSMQ-ADIntegration", "MSMQ-DCOMProxy", "MSMQ-HTTP", "MSMQ-Multicast", "MSMQ-RoutingServer", "MSMQ-Server", "MSMQ-Services", "MSMQ-Triggers"],
    "removePayload": true
  }
}
