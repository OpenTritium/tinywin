{
  "schemaVersion": 1,
  "id": "dism.remove-failover-clustering",
  "version": "1.0.0",
  "title": "移除故障转移群集",
  "description": "移除 Failover Clustering 服务、管理控制台、PowerShell 和命令行组件；无法创建或管理 Windows 群集。",
  "category": "Server Roles",
  "risk": "High",
  "handler": "Dism.RemoveOptionalComponent",
  "phase": "MountedImage",
  "parameters": {
    "features": ["FailoverCluster-FullServer", "FailoverCluster-Mgmt", "FailoverCluster-PowerShell", "FailoverCluster-CmdInterface", "FailoverCluster-AdminPak", "FailoverCluster-AutomationServer"],
    "removePayload": true
  }
}
