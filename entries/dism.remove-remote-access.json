{
  "schemaVersion": 1,
  "id": "dism.remove-remote-access",
  "version": "1.0.0",
  "title": "移除 Remote Access 与路由服务",
  "description": "移除 RRAS、VPN、NAT、网关和远程访问管理工具；本机不能作为 VPN、路由或 NAT 网关。",
  "category": "Networking",
  "risk": "High",
  "selectionTier": "Expert",
  "handler": "Dism.RemoveOptionalComponent",
  "phase": "MountedImage",
  "parameters": {
    "features": ["RemoteAccess", "RemoteAccessServer", "RemoteAccessMgmtTools", "RemoteAccessPowerShell", "RasServerAdminTools", "RasRoutingProtocols", "Gateway", "Gateway-UI"],
    "removePayload": true
  }
}
