  "risk": "High",
  "selectionTier": "Experimental",
  "handler": "Dism.RemovePackage",
  "phase": "MountedImage",
  "parameters": {
    "packagePatterns": ["EdgeChromium", "Microsoft.*Edge"]
  }
}
