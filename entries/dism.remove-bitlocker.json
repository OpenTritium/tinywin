{
  "schemaVersion": 1,
  "id": "dism.remove-bitlocker",
  "version": "1.0.0",
  "title": "移除 BitLocker 管理组件",
  "description": "移除 BitLocker 工具、网络解锁和远程管理扩展；BitLocker 卷加密配置与恢复管理将不可用。",
  "category": "Security",
  "risk": "High",
  "selectionTier": "Experimental",
  "handler": "Dism.RemoveOptionalComponent",
  "phase": "MountedImage",
  "parameters": {
    "features": ["Bitlocker-Utilities", "BdeAducExtTool", "BitLocker-NetworkUnlock", "BitLocker-RemoteAdminTool"],
    "removePayload": true
  }
}
