{
  "schemaVersion": 1,
  "id": "dism.remove-dotnet-framework-3.5",
  "version": "1.0.0",
  "title": "移除 .NET Framework 3.5",
  "description": "移除 .NET Framework 3.5 和 Server 扩展；依赖 .NET 2.0/3.0/3.5 的旧版应用将无法运行。",
  "category": "Frameworks",
  "risk": "High",
  "handler": "Dism.RemoveOptionalComponent",
  "phase": "MountedImage",
  "parameters": {
    "features": ["NetFx3", "NetFx3ServerFeatures"],
    "removePayload": true
  }
}
