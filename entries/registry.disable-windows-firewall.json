{
  "schemaVersion": 1,
  "id": "registry.disable-windows-firewall",
  "version": "1.0.0",
  "title": "禁用 Windows 防火墙",
  "description": "将域、专用和公用网络配置文件的防火墙策略设为关闭。设备暴露在不受信任网络时风险极高。",
  "category": "Security",
  "risk": "High",
  "handler": "Registry.SetOfflineValue",
  "phase": "MountedImage",
  "parameters": {
    "hive": "SOFTWARE",
    "values": [
      {
        "key": "Policies\\Microsoft\\WindowsFirewall\\DomainProfile",
        "name": "EnableFirewall",
        "type": "DWord",
        "value": 0
      },
      {
        "key": "Policies\\Microsoft\\WindowsFirewall\\PrivateProfile",
        "name": "EnableFirewall",
        "type": "DWord",
        "value": 0
      },
      {
        "key": "Policies\\Microsoft\\WindowsFirewall\\PublicProfile",
        "name": "EnableFirewall",
        "type": "DWord",
        "value": 0
      }
    ]
  }
}
