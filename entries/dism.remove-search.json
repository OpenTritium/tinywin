{
  "schemaVersion": 1,
  "id": "dism.remove-search",
  "version": "1.0.0",
  "title": "移除 Windows Search",
  "description": "移除 Windows Search 索引和搜索组件；资源管理器搜索能力会受影响。",
  "category": "System",
  "risk": "High",
  "handler": "Dism.RemoveOptionalComponent",
  "phase": "MountedImage",
  "parameters": {
    "features": ["SearchEngine-Client-Package", "File-Services-Search-Service"],
    "removePayload": true
  }
}
