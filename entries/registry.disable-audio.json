{
  "schemaVersion": 1,
  "id": "registry.disable-audio",
  "version": "1.0.0",
  "title": "禁用 Windows 音频服务",
  "description": "禁用 Audiosrv 和 AudioEndpointBuilder；系统音频输出、录音以及依赖音频会话的应用将不可用。",
  "category": "Devices",
  "risk": "High",
  "selectionTier": "Expert",
  "handler": "Registry.DisableOfflineService",
  "phase": "MountedImage",
  "parameters": {
    "services": ["Audiosrv", "AudioEndpointBuilder"]
  }
}
